# Every variable below maps 1:1 to a field on app/core/config.py -> Settings.
# Names are case-insensitive; this file uses the conventional uppercase form.

# ---------------------------------------------------------------- app
APP_NAME=Tarbiyat
# development | production. In production the app refuses to boot while SECRET_KEY is
# still the development default, so set a real one before deploying.
ENVIRONMENT=development
DEBUG=false

# ---------------------------------------------------------------- auth
# JWT signing key. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave the value below as-is for local dev - it is the recognised default, and the
# production guard checks for exactly this string.
SECRET_KEY=dev-only-insecure-secret-change-me
ALGORITHM=HS256
# Token lifetime in minutes. 1440 = 24 hours.
ACCESS_TOKEN_TTL_MINUTES=1440

# ---------------------------------------------------------------- database
# SQLite by default so the repo runs with no setup. For Postgres:
#   DATABASE_URL=postgresql+psycopg://tarbiyat:tarbiyat@localhost:5432/tarbiyat
DATABASE_URL=sqlite:///./tarbiyat.db

# ---------------------------------------------------------------- cors
# "*" for open dev, or a comma-separated origin list.
CORS_ORIGINS=*

# ---------------------------------------------------------------- uploads
# Largest CSV accepted, in bytes.
MAX_UPLOAD_BYTES=5000000
# Rows and columns considered when profiling/training.
MAX_DATASET_ROWS=20000
MAX_DATASET_COLUMNS=60

# ---------------------------------------------------------------- training ceilings
# Hard server-side caps so one request cannot occupy a worker indefinitely.
MAX_EPOCHS=400
MAX_HIDDEN_LAYERS=4
MAX_LAYER_WIDTH=256
# Declared on Settings but not yet enforced - reserved for a worker-queue build.
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------- rate limits
# Format: "<count>/<second|minute|hour|day>". Applied per client IP, per path.
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_WRITE=60/minute

# ---------------------------------------------------------------- demo seed
# Creates the demo account + starter datasets on first boot. The seed refuses to write
# a known password when ENVIRONMENT=production.
SEED_DEMO_USER=true
DEMO_EMAIL=demo@tarbiyat.pk
DEMO_PASSWORD=tarbiyat-demo-2026
